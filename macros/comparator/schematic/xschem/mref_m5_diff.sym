v {xschem version=3.4.8RC file_version=1.3}
K {type=subcircuit
format="@name @pinlist @symname"
spectre_format="@name ( @pinlist ) @symname"
template="name=x1"
}
T {@symname} -90 -6 0 0 0.3 0.3 {}
T {@name} 135 -52 0 0 0.2 0.2 {}
P 4 5 130 -40 -130 -40 -130 40 130 40 130 -40 {}
B 5 147.5 -32.5 152.5 -27.5 {name=ibias dir=inout}
L 7 130 -30 150 -30 {}
T {ibias} 125 -34 0 1 0.2 0.2 {}
B 5 147.5 -2.5 152.5 2.5 {name=tail dir=inout}
L 7 130 0 150 0 {}
T {tail} 125 -4 0 1 0.2 0.2 {}
B 5 147.5 27.5 152.5 32.5 {name=avss dir=inout}
L 7 130 30 150 30 {}
T {avss} 125 26 0 1 0.2 0.2 {}
